"""
Visium HD end-to-end Snakemake pipeline
========================================
    spaceranger_count
         ↓
    preprocess_umap → leiden_analysis (per sample × resolution)
         ↓
    ingest_ref (optional)
         ↓
    annotate_cells (TSV + marker refinement + external)
         ↓
    pseudobulk_aggregate → pseudobulk_de (R)
    neighbourhood_analysis
    integrate_samples → subcluster
"""

import os
import sys
import pandas as pd
from snakemake.utils import validate, min_version

min_version("8.0")

configfile: "config.yaml"
validate(config, schema="schemas/config.schema.yaml")

ANALYSIS   = config.get("analysis", {})
_region_colors = ANALYSIS.get("region_colors", {})
REGION_LEVELS  = ANALYSIS.get("region_levels", list(_region_colors.keys()))
LOGDIR     = config["logdir"]
OUTDIR_SR  = config["spaceranger_processing_outdir"]
OUTDIR_PP  = config["post_processing_outdir"]
GEOJ_DIR   = config["geojson_path"]
SAMPLES_DIR = f"{OUTDIR_PP}/Samples"
RANDOM_SEED = config.get("random_seed", 42)

# ── Input contract (modular head → core hand-off) ────────────────────────────
# prepare_input WRITES this unfiltered h5ad; validate_input, qc_sweep and
# preprocess_umap READ it. Path + validation root are derived here from
# post_processing_outdir so they follow SAMPLES_DIR automatically (set after the
# config-schema validation above, so they don't need to be declared in the schema).
config.setdefault("contract", {})
config["contract"]["unfiltered_h5ad"] = f"{SAMPLES_DIR}/{{sample}}/{{sample}}_unfiltered.h5ad"
config["outdir"] = SAMPLES_DIR     # validate_input / qc_sweep write under the per-sample tree

samples_df = (
    pd.read_csv(config["samples"])
    .fillna("")
    .set_index("sample_id", drop=False)
)
validate(samples_df, schema="schemas/samples.schema.yaml")

SAMPLES    = samples_df.to_dict(orient="index")
SAMPLE_IDS = list(SAMPLES.keys())

def _resolution_range(rmin, rmax, step):
    n = round((rmax - rmin) / step)
    return [round(rmin + i * step, 10) for i in range(n + 1)]

RESOLUTIONS = [
    str(r)
    for r in _resolution_range(
        ANALYSIS.get("resolution_scan_min", 0.2),
        ANALYSIS.get("resolution_scan_max", 1.0),
        ANALYSIS.get("resolution_scan_step", 0.2),
    )
]

ANNOT_TYPES = ["tsv_annotation"] # "refined_annotation"

# Add external annotation type if configured
ext_annot = config.get("external_annotation", {})
if ext_annot.get("enabled", False):
    ANNOT_TYPES.append("external_annotation")

ANALYSIS_LEVELS = ANALYSIS.get("analysis_levels", ["by_region", "by_celltype_region"])

# Pseudobulk DESeq2 DE is OPTIONAL and OFF by default (the pseudobulk_aggregate
# count matrices + PCA QC are still produced; only the R/DESeq2 step is gated).
RUN_DE = bool(ANALYSIS.get("run_pseudobulk_de", False))


def _cluster_annotations_available():
    path = config.get("cluster_annotations", "")
    if not path or not os.path.isfile(path):
        return False
    try:
        df = pd.read_csv(path, sep="\t", index_col=0)
        return df.shape[0] > 0 and df.shape[1] > 0 and not df.isna().all().all()
    except Exception:
        return False

HAS_CLUSTER_ANNOT = _cluster_annotations_available()
HAS_INGEST_REF = bool(config.get("ingest_ref", ""))
USE_PRECOMPUTED = config.get("use_precomputed_clusters", False)

GENE_EXPLORATION = config.get("gene_exploration", {})
_gene_queries_path = GENE_EXPLORATION.get("queries", "")
HAS_GENE_EXPLORATION = bool(_gene_queries_path) and os.path.isfile(_gene_queries_path)

SPATIAL_NICHES = config.get("spatial_niches", {})
SPATIAL_NICHES_ENABLED = bool(SPATIAL_NICHES.get("enabled", False))
# The spatial_niches rule always runs when enabled; it reloads precomputed niche
# TSVs internally (use_precomputed + niche_dir) instead of being bypassed, so it
# still produces the canonical TSVs / concatenated h5ad / plots cheaply.


def get_resource(rule_name, key):
    section = config.get("resources", {})
    rule_res = section.get(rule_name, section.get("default", {}))
    if key not in rule_res:
        sys.exit(f"[config error] Resource '{key}' missing for rule '{rule_name}'.")
    return rule_res[key]

def fastq_dirs_comma_separated(wc):
    s = SAMPLES[wc.sample]
    dirs = [f"{s['fastq_dir']}/fastqs/"]
    for col in ("resequenced_dir", "new_resequenced_dir", "third_resequencing_dir"):
        val = s.get(col, "")
        if val not in ("", "nan"):
            dirs.append(f"{val}/fastqs/")
    return ",".join(dirs)

def get_all_targets(wildcards):
    targets = []
    for sample in SAMPLE_IDS:
        targets.append(f"{SAMPLES_DIR}/{sample}/adata_{sample}.h5ad")
        targets.append(f"{SAMPLES_DIR}/{sample}/metadata_{sample}.tsv")
        targets.append(f"{SAMPLES_DIR}/{sample}/QuPath_image/{sample}_tissue_hires_image.png")
        for res in RESOLUTIONS:
            targets.append(f"{SAMPLES_DIR}/{sample}/leiden_resolution_{res}")
    if SPATIAL_NICHES_ENABLED:
        targets.append(f"{OUTDIR_PP}/spatial_niches/spatial_niches_concatenated.h5ad")
        targets.append(f"{OUTDIR_PP}/spatial_niches/plots")
        targets.extend(expand(
            f"{OUTDIR_PP}/spatial_niches/tsv/niche_{{sample}}.tsv",
            sample=SAMPLE_IDS))
    if HAS_CLUSTER_ANNOT:
        if HAS_INGEST_REF:
            for sample in SAMPLE_IDS:
                targets.append(f"{SAMPLES_DIR}/{sample}/adata_{sample}_ingested.h5ad")
        for sample in SAMPLE_IDS:
            targets.append(f"{SAMPLES_DIR}/{sample}/adata_{sample}_annotated.h5ad")
        for sample in SAMPLE_IDS:
            for at in ANNOT_TYPES:
                targets.append(f"{SAMPLES_DIR}/{sample}/neighbourhood_analysis/{at}")
        for at in ANNOT_TYPES:
            for level in ANALYSIS_LEVELS:
                targets.append(f"{OUTDIR_PP}/pseudobulk/{at}/{level}/aggregated")
                if RUN_DE:
                    targets.append(f"{OUTDIR_PP}/pseudobulk/{at}/{level}/de_results")
        targets.append(f"{OUTDIR_PP}/integrated_samples/concatenated.h5ad")
        targets.append(f"{OUTDIR_PP}/integrated_samples/harmony_integrated.h5ad")
        targets.append(f"{OUTDIR_PP}/integrated_samples/sketched.h5ad")
        targets.append(f"{OUTDIR_PP}/integrated_samples/samples_report.pdf")
        if HAS_GENE_EXPLORATION:
            targets.append(f"{OUTDIR_PP}/gene_exploration/expression_ranges.tsv")
            targets.extend(expand(
                f"{OUTDIR_PP}/gene_exploration/.sentinels/{{sample}}.done",
                sample=SAMPLE_IDS))
    subcomps = config.get("subcompartments", {})
    if subcomps:
        for sc_name in subcomps:
            targets.append(f"{OUTDIR_PP}/Subcompartments/{sc_name}")
    return targets


# ── Include rules ────────────────────────────────────────────────────────────
include: "rules/spaceranger.smk"
include: "rules/generate_qupath_image.smk"   # HEAD: hires image for QuPath annotation
include: "rules/prepare_input.smk"           # HEAD: builds the unfiltered contract h5ad
include: "rules/validate_input.smk"          # CORE: input-contract gate (per sample)
include: "rules/qc_sweep.smk"                # CORE: optional pre-filtering QC diagnostic
include: "rules/preprocess_umap.smk"
include: "rules/leiden_analysis.smk"
include: "rules/ingest_ref.smk"
include: "rules/spatial_niches.smk"
include: "rules/annotate_cells.smk"
include: "rules/pseudobulk_aggregate.smk"
include: "rules/pseudobulk_de.smk"
include: "rules/neighbourhood_analysis.smk"
include: "rules/integrate_samples.smk"
include: "rules/subcluster.smk"
include: "rules/generate_annotation_template.smk"
include: "rules/sample_report.smk"
include: "rules/explore_genes.smk"


# ── Targets ──────────────────────────────────────────────────────────────────
rule all:
    input:
        get_all_targets,
        f"{OUTDIR_PP}/cluster_annotations_template.tsv",

rule run_upstream:
    """Spaceranger, preprocessing, leiden, annotation template, ingest (if configured)."""
    input:
        expand(f"{SAMPLES_DIR}/{{sample}}/adata_{{sample}}.h5ad", sample=SAMPLE_IDS),
        expand(f"{SAMPLES_DIR}/{{sample}}/metadata_{{sample}}.tsv", sample=SAMPLE_IDS),
        expand(f"{SAMPLES_DIR}/{{sample}}/QuPath_image/{{sample}}_tissue_hires_image.png",
               sample=SAMPLE_IDS),
        expand(f"{SAMPLES_DIR}/{{sample}}/leiden_resolution_{{res}}",
               sample=SAMPLE_IDS, res=RESOLUTIONS),
        f"{OUTDIR_PP}/cluster_annotations_template.tsv",
        *(expand(f"{SAMPLES_DIR}/{{sample}}/adata_{{sample}}_ingested.h5ad",
                 sample=SAMPLE_IDS) if HAS_INGEST_REF else []),
        *([f"{OUTDIR_PP}/spatial_niches/spatial_niches_concatenated.h5ad"]
          if SPATIAL_NICHES_ENABLED else []),

rule run_downstream:
    """Annotation + DE + neighbourhood + integration."""
    input:
        expand(f"{SAMPLES_DIR}/{{sample}}/adata_{{sample}}_annotated.h5ad", sample=SAMPLE_IDS),
        *(expand(f"{OUTDIR_PP}/pseudobulk/{{at}}/{{level}}/de_results",
                 at=ANNOT_TYPES, level=ANALYSIS_LEVELS) if RUN_DE else []),
        expand(f"{SAMPLES_DIR}/{{sample}}/neighbourhood_analysis/{{at}}",
               sample=SAMPLE_IDS, at=ANNOT_TYPES),
        f"{OUTDIR_PP}/integrated_samples/concatenated.h5ad",
        f"{OUTDIR_PP}/integrated_samples/harmony_integrated.h5ad",
        f"{OUTDIR_PP}/integrated_samples/sketched.h5ad",
        f"{OUTDIR_PP}/integrated_samples/samples_report.pdf",

rule subcluster_all:
    """Run all subcompartment analyses."""
    input:
        expand(f"{OUTDIR_PP}/Subcompartments/{{sc}}",
               sc=list(config.get("subcompartments", {}).keys())),

rule qupath_images:
    """HEAD: generate the hires images to annotate in QuPath.

    Run this FIRST, annotate in QuPath, export each
    {sample}_tissue_hires_image.geojson into geojson_path, then run prepare_input
    (or run_upstream) onward."""
    input:
        expand(f"{SAMPLES_DIR}/{{sample}}/QuPath_image/{{sample}}_tissue_hires_image.png",
               sample=SAMPLE_IDS),

rule qc_sweep_all:
    """Optional pre-filtering QC diagnostic for every sample (no filtering)."""
    input:
        expand(f"{SAMPLES_DIR}/{{sample}}/qc_sweep/qc_violins.png", sample=SAMPLE_IDS),

rule explore_genes:
    """Generate gene/signature exploration PNGs (integrated + per sample)."""
    input:
        f"{OUTDIR_PP}/gene_exploration/expression_ranges.tsv",
        expand(f"{OUTDIR_PP}/gene_exploration/.sentinels/{{sample}}.done",
               sample=SAMPLE_IDS),
