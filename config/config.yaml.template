# SpaceBlocks configuration.  Full explanations: config/README.md (or the online docs https://cbib.github.io/SpaceBlocks/configuration/).
# Every key is validated against workflow/schemas/config.schema.yaml before the run starts.

# ─── Run mode — which headblock builds the contract h5ad ─────────────────────
mode: decoupled

# ─── input/output directories ────────────────────────────────────────────────
## BASE DIRECTORY #############################################################
##
## You may modify 'base_dir' to point to your project results directory.
## This is useful to keep results in a fast filesystem separate from the source code.
## Paths relative to base_dir can be left as is,
## or be overridden with absolute paths if desired.

base_dir: /path/to/SpaceBlocks/results

## Paths that are not relative to base_dir and must be set explicitly below:
# spaceranger, probe_set, transcriptome, ingest_ref
###############################################################################

post_processing_outdir: "{base_dir}/output"
logdir: "{base_dir}/logs"
spaceranger_processing_outdir: "{base_dir}/spaceranger_results"
# dir with region annotation GeoJSONs (optional, recommended)
geojson_path: "/path/to/geojson"
# only when using "mode: decoupled" — dir of pre-built contract h5ads
contract_dir: '/path/to/preformatted_contract_h5ads'

# ─── Reproducibility & reuse   (docs → Configuration) ────────────────────────
random_seed: 0
precomputed_metadata_dir: '/path/to/precomputed_metadata'
# reuse clusters from precomputed_metadata_dir
use_precomputed_clusters: false

# ─── Sample sheets ───────────────────────────────────────────────────────────
core_samples: config/core_samples.tsv
# only when using "mode: visiumhd" — fastq/slide/area per sample
samples: config/visiumhd_samples.csv

# ─── Visium HD head   (mode: visiumhd) ───────────────────────────────────────
spaceranger: /path/to/spaceranger-4.0.1/spaceranger # external install; path to the executable
probe_set: /path/to/Visium_Human_Transcriptome_Probe_Set_v2.1.0_GRCh38-2024-A.csv
transcriptome: /path/to/cellranger/refdata-gex-GRCh38-2024-A

# ─── Xenium 5K head   (mode: xenium5k) ───────────────────────────────────────
xenium5k:
  # xenium_dir is the directory containing the Xenium 5K samples.
  # Make sure to keep the {sample} placeholder in the path.
  xenium_dir: "/path/to/xenium/{sample}"
  qupath_pyramid_level: 3
  hires_pyramid_level: 3
  pixel_size_um: 0.2125

# ─── Contract — Head → Core hand-off ─────────────────────────────────────────
contract:
  sample_key: sample
  spatial_key: spatial
  require_region: false
  require_raw_counts: true
  mito_prefix:
    - MT-
    - mt-

# ─── QC & preprocessing ──────────────────────────────────────────────────────
# qc thresholds to screen in qc_sweep_all
qc_sweep:
  # use ingest_ref
  ingest_enabled: false
  ingest_key: cell_type_ingest
  cell_id_key: cell_id
  dpi: 300
  # thresholds to screen
  thresholds:
    min_genes:
      - 50
      - 100
      - 200
    min_counts:
      - 1
      - 10
      - 50
    max_counts:
      - 3000
      - 5000
    max_pct_mt:
      - 10
      - 15
      - 20

# optional: per-sample QC thresholds TSV (example at config/per_sample_qc.tsv)
per_sample_qc: ''
# default: global thresholds
analysis:
  # qc thresholds
  plot_dpi: 300
  # marker sizes for UMAP embeddings and spatial maps, respectively
  umap_point_size: 2
  spatial_point_size: 20
  min_counts: 1
  min_cells: 3
  min_genes: 100
  # umap
  n_neighbors: 10
  n_pcs: 30
  # n marker genes; n DE genes in pseudobulk heatmaps
  de_n_genes: 25
  # leiden
  resolution_scan_min: 0.6
  resolution_scan_max: 0.8
  resolution_scan_step: 0.2
  min_cells_per_type: 15
  # integrate
  sketch_fraction: 0.25
  # pseudobulk
  run_pseudobulk_de: true
  run_leiden_analysis: true
  min_cells_per_pseudobulk: 10
  min_replicates: 3
  min_counts_per_pseudobulk: 1000
  padj_threshold: 0.05
  lfc_threshold: 0.25
  # Each named analysis defines one aggregation and one DE model. `cell_type` is
  # resolved to the annotation selected by annotation_types. Multiple group_by
  # columns form one combined comparison group; interactions are not fitted.
  pseudobulk:
    analyses:
      - name: regions_all_cells
        aggregation: by_region
        group_by:
          - region_annotation
        paired_by: sample
        exclude_levels:
          region_annotation:
            - Unlabeled
        contrasts:
          - name: tumor_vs_healthy
            numerator:
              region_annotation: Tumor area
            denominator:
              region_annotation: Healthy area
        # Omnibus test across every sufficiently replicated, non-excluded region.
        # Note: LRT only runs when more than >= 3 levels are present after filtering by exclude_levels and min_replicates.
        lrt:
          enabled: true

      - name: regions_by_celltype
        aggregation: by_celltype_region
        group_by:
          - region_annotation
        paired_by: sample
        exclude_levels:
          region_annotation:
            - Unlabeled
          cell_type:
            - Unannotated
        contrasts:
          - name: tumor_vs_healthy
            numerator:
              region_annotation: Tumor area
            denominator:
              region_annotation: Healthy area
        # Note: LRT only runs when more than >= 3 levels are present after filtering by exclude_levels and min_replicates.
        lrt:
          enabled: true

  # Preferred region order for QC-sweep, subcluster, and region-only pseudobulk split
  # heatmaps, first-to-last (typically left-to-right). This does not filter pseudobulk
  # levels; use each analysis' exclude_levels for filtering.
  region_levels:
    - Healthy area
    - Premalignant area
    - Tumor area

  # Palette used when region_annotation is the single comparison variable.
  region_colors:
    Healthy area: '#FDE725FF'
    Premalignant area: '#1FA187FF'
    Tumor area: '#46337EFF'


# ─── Annotation ──────────────────────────────────────────────────────────────
# (optional, recommended) predefined cell type markers, screened during leiden to ease annotation
snakemake_cell_markers: config/snakemake_cell_markers.tsv
# (default) cluster → cell-type TSV (fill template from generate_annotation_template)
cluster_annotations: config/cluster_annotations.tsv
# (optional) external labels from metadata TSVs, or from contract h5ad obs in decoupled mode
external_annotation:
  enabled: false
  column: manual_celltype  # arbitrary source name; normalized to cell_type_external
  keep_unannotated: true
ingest_ref: '/path/to/ingest_ref_data/ref.h5ad'  # optional annotated scRNA-seq reference (ingest_ref)
ingest_ref_label_key: cell_type_annotation_column
integration:
  integrate_key: sample
# (optional) include annotations for downstream plots from core_samples.tsv
extra_annotations:
  columns:
    - condition
    - batch

# ─── Spatial niches   (optional) ─────────────────────────────────────────────
spatial_niches:
  enabled: true
  # use niche_dir precomputed .tsv
  use_precomputed: false
  niche_dir: '/path/to/precomputed_niches'
  lambda: 0.8
  num_neighbours: 18
  cluster_n_neighbours: 50
  n_iterations: -1
  max_m: 1
  nbr_weight_decay: scaled_gaussian
  # (recommended) use only HVGs for niche clustering
  use_hvg: true
  n_top_genes: 2000
  niche_resolution: 0.1
  # (optional) BANKSY refine niches
  refine: false
  refine_num_neigh: 6
  refine_iterations: 1
  refine_auto: false
  compute_umap: false

# ─── Subcompartments   (optional) ────────────────────────────────────────────
subcompartments:
  # subcompartment name (example)
  Fibroblasts:
    # exact-string match of cell type names to pool together
    strings:
      - Fibroblasts
      - Fibroblasts_COLA1
      - Fibroblasts_COLA2
    # resolution range to screen in leiden clustering
    resolution_min: 0.6
    resolution_max: 1.2
    resolution_step: 0.2

# ─── Gene / signature exploration ────────────────────────────────────────────
gene_exploration:
  # tsv where col name is gene set name, values are genes (one or more)
  queries: config/gene_queries.tsv
  aucell_max_rank_fraction: 0.05
  niche_column: spatial_niche
  dpi: 300

# ─── Colour palettes   (docs → Configuration) ────────────────────────────────
# region color palettes is found under analysis: region_colors
sample_colors:
  # extra column in core_samples.tsv
  condition:
    # levels and HEX code; unfound levels fall back to grey
    Control: '#0072B2'
    Treatment: '#D55E00'
  batch:
    Batch 1: '#8E44AD'
    Batch 2: '#C0392B'
annotation_colors:
  # levels in cluster_annotations.tsv
  cell_type_tsv:
    Keratinocytes: '#d62728'
    Tcells: '#1f77b4'
    Fibroblasts: '#2ca02c'
  # levels when external_annotation: enabled: true
  cell_type_external:
    Keratinocytes: '#d62728'
    Tcells: '#1f77b4'
    Fibroblasts: '#2ca02c'

